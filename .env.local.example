# Copy this file to .env.local and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
#
# Both values are safe to expose to the browser (they are protected by
# Row Level Security). NEVER put the "service_role" / "secret" key here.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (sb_publishable_...). The legacy "anon" key works too.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Your team's time zone (IANA name). Decides what "today" and "next
# lineup" mean. Defaults to Asia/Manila. Server-only, so it has no NEXT_PUBLIC_ prefix.
# APP_TIMEZONE=Asia/Manila

# Public URL of the site, used in password-reset emails.
# Locally: http://localhost:3000   On Vercel: https://your-site.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
